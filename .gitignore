# Widget Preview related
.widget_preview/

# Backend + deployment artifacts — this repo is app code only. The PHP API,
# DB schema and any secrets (.env, PayPal/DB credentials) live in
# server/ and stay out of git entirely; see server/api_turret/README.md for
# how that gets deployed (uploaded directly to the host, not via git).
/server/
*.zip

# Raw CraftPix source kit (.ai/.eps originals) — not used by the app
# (pubspec.yaml only references assets/images/, assets/audio/, etc.), and
# redistributing the purchased kit's source files publicly is very likely
# outside what https://craftpix.net/file-licenses/ allows. The processed
# assets the app actually ships with (assets/images/, audio/, logo/, music/)
# are NOT excluded here — only this original/unused source folder is.
/assets/Merge Turrets/

# Raw/uncompressed music source (.wav, ~85MB) — not referenced anywhere in
# pubspec.yaml or lib/ (the app actually ships the compressed assets/audio/
# .mp3 files). Unused bulk, so it stays out of the repo.
/assets/music/
